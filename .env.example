# Шаблон конфигурации. Скопируйте в .env и подставьте свои значения.
# В .env ключи должны быть ASCII-символами: кириллица вызывает UnicodeEncodeError.

# paper | demo | live. Для live дополнительно требуется CONFIRM_LIVE=YES.
MODE=paper

# Тип рынка MEXC: swap (фьючерсы — есть плечо и SHORT) | spot (только LONG).
MARKET_TYPE=swap

# Режим маржи на фьючерсах: isolated (своя маржа у позиции) | cross.
MARGIN_MODE=isolated

MEXC_API_KEY=
MEXC_API_SECRET=
CONFIRM_LIVE=

# Символы пишутся как BTC/USDT. Для MARKET_TYPE=swap сюда добавится :USDT
# автоматически (получится BTC/USDT:USDT — так фьючерсы называются в ccxt).
SYMBOLS=BTC/USDT,ETH/USDT
TIMEFRAME=15m
LOOP_SECONDS=30

# Проверять новые входы каждые 15 секунд.
ENTRY_SCAN_SECONDS=15
ENTRY_COOLDOWN_SECONDS=15

LEVERAGE=3
MAX_LEVERAGE=5

# Сколько % депозита теряем, если сработает стоп.
RISK_PER_TRADE_PCT=1
# Максимум маржи в одной позиции, % депозита.
MAX_POSITION_PCT=15
MAX_OPEN_POSITIONS=2

# Стопы бота: -15% от пика или -5% за день.
MAX_DRAWDOWN_PCT=15
DAILY_LOSS_PCT=5

# Баланс для paper-режима. В live игнорируется — бот берёт реальный с биржи.
PAPER_BALANCE=1000

# Не ставить ордера дешевле этой суммы (MEXC отклоняет меньше 1 USDT).
MIN_ORDER_VALUE=1
# Как часто обновлять реальный баланс в live, сек.
EQUITY_REFRESH_SECONDS=20

# Telegram необязателен; доступ только этому числовому ID.
TELEGRAM_TOKEN=
TELEGRAM_ADMIN_ID=0

# AI-фильтр выключен по умолчанию; ключ никогда не отправляется модели.
AI_ENABLED=false
AI_MIN_CONFIDENCE=0.75
OPENAI_MODEL=gpt-4o-mini
# Optional OpenAI-compatible API root, e.g. https://www.getunikey.ai/v1
OPENAI_BASE_URL=
AI_TIMEOUT_SECONDS=10
# 0 = без автоматических повторов внутри торгового цикла.
AI_MAX_RETRIES=0
# При hold ошибка/нет ключа блокирует сигнал; allow пропускает AI-фильтр.
AI_FAIL_MODE=hold
OPENAI_API_KEY=

# Короткий лог повторной проверки текущей свечи.
LOG_ENTRY_RECHECKS=false

# Render: leave empty to use Telegram polling (Mini App uses Render PORT)
TELEGRAM_WEBHOOK_URL=
